# NileChain Chroma Proxy — local defaults (never commit real secrets)

# cloud | persistent | http
CHROMA_MODE=persistent
CHROMA_PERSIST_DIR=./.chroma-data

# Chroma Cloud (required when CHROMA_MODE=cloud)
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=
# Optional non-default region host:
# CHROMA_HOST=

# Self-hosted Chroma server (when CHROMA_MODE=http)
# CHROMA_SERVER_HOST=localhost
# CHROMA_SERVER_PORT=8000
# CHROMA_SERVER_SSL=false

# Optional shared secret (NileChain must send X-NileChain-Proxy-Key if set)
# PROXY_API_KEY=

# Demo seeding via POST /seed
ALLOW_SEED=true

LOG_LEVEL=INFO
PORT=8001
REQUEST_TIMEOUT_SECONDS=60
