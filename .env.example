# Copy to .env and fill locally. Never commit real keys.
# ASP.NET Core also accepts nested keys as Section__Key (e.g. Jwt__Secret).

# Database
ConnectionStrings__DefaultConnection=Server=...;Database=...;User Id=...;Password=...;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True

# JWT
Jwt__Issuer=NileChain.Api
Jwt__Audience=NileChain.Client
Jwt__Secret=replace_with_a_long_random_secret

# LLM provider: failover | Sbg | OpenAI | OpenRouter
# failover = SBG → OpenAI/Groq → OpenRouter automatically
LLM_PROVIDER=failover

# OpenAI-compatible fallback (Groq example)
# OPENAI_API_KEY=gsk_...
# OpenAI__Model=llama-3.3-70b-versatile
# OpenAI__Endpoint=https://api.groq.com/openai/v1

# OpenRouter fallback (OpenAI-compatible)
# OPEN_ROUTER_API_KEY=sk-or-v1-...
# OPEN_ROUTER_MODEL=openrouter/free
# OPEN_ROUTER_ENDPOINT=https://openrouter.ai/api/v1

# Student Bedrock Gateway (ITI) — preferred when Llm:Provider=failover
# Portal / key page: http://apiaccess.iti.net.eg/student
SBG_API_KEY=your_sbg_key_here
SBG_BASE_URL=http://apiaccess.iti.net.eg
SBG_MODEL_ID=amazon.nova-lite-v1:0
Sbg__MaxTokens=2048
Sbg__ChatPath=/api/v1/student/chat

# RAG — NileChain ChromaService contract (POST /query|/add|/upsert)
# Local: run backend/chroma-proxy on port 8001
# Production (Heroku): set to the deployed proxy HTTPS origin (no trailing slash)
Chroma__BaseUrl=http://localhost:8001

# Frontend / CORS
App__FrontendBaseUrl=http://localhost:4200
# Comma-separated override, or use Cors__Origins__0 / Cors__Origins__1
# Cors__Origins=http://localhost:4200,http://127.0.0.1:4200

# Monitoring (Development appsettings enables this; Production default is off)
Monitoring__Enabled=true
Monitoring__IntervalMinutes=2

# Production-only optional admin bootstrap (never uses the known Development password)
# IdentitySeed__AdminEmail=
# IdentitySeed__AdminPassword=

# Demo SQL/Chroma seed (explicit only — do not set on Heroku unless intentional)
# SEED_DEMO_ON_STARTUP=1
