{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "NileChain.Api",
    "Audience": "NileChain.Client",
    "Secret": "__SET_IN_LOCAL_CONFIG__",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "NileChain",
    "SenderEmail": "",
    "Username": "",
    "Password": "",
    "UseSsl": false
  },
  "App": {
    "BaseUrl": "https://localhost:7018",
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Llm": {
    "Provider": "failover"
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "Endpoint": ""
  },
  "OpenRouter": {
    "ApiKey": "",
    "Model": "openrouter/free",
    "Endpoint": "https://openrouter.ai/api/v1"
  },
  "Sbg": {
    "BaseUrl": "http://apiaccess.iti.net.eg",
    "ApiKey": "",
    "ModelId": "amazon.nova-lite-v1:0",
    "MaxTokens": 2048,
    "ChatPath": "/api/v1/student/chat"
  },
  "Chroma": {
    "BaseUrl": "http://localhost:8001"
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  },
  "Monitoring": {
    "Enabled": false,
    "IntervalMinutes": 2
  },
  "Matching": {
    "MaxResults": 5,
    "NearbyRadiusKm": 50
  },
  "PaymentMilestones": {
    "Schedule": [
      { "Key": "Deposit", "Label": "Deposit (advance)", "Percent": 30 },
      { "Key": "OnDelivery", "Label": "On delivery", "Percent": 70 }
    ]
  },
  "OpenApi": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
